     def ask(self, question: str, lesson: Optional[Dict] = None, mode: str = "chat") -> Dict:
+        """Ask the configured workspace a question.
+
+        ``mode`` is what actually constrains the answer. The prompt below tells
+        the model to answer only from the lesson and the workspace, but a prompt
+        is a request, not an enforcement: in ``"chat"`` mode the underlying model
+        may still answer from its own general knowledge. Pass ``mode="query"``
+        when the grounding claim has to hold, and check the result with
+        :meth:`has_sources` before showing it as an evidence-backed answer.
+        Confirm the mode semantics against your own AnythingLLM version.
+        """
         if not self.cfg.workspace_slug:
             raise RuntimeError("ANYTHINGLLM_WORKSPACE_SLUG تنظیم نشده است.")
         message = question.strip()
@@ -88,6 +98,20 @@
         return data
 
     @staticmethod
+    def has_sources(data: Dict) -> bool:
+        """True when the answer carried workspace citations.
+
+        Without this, nothing in the pipeline distinguishes a grounded answer
+        from one the model produced on its own - the instruction in ``ask`` is
+        the only guarantee, and nothing checks it.
+        """
+        for key in ("sources", "citations", "sourceDocuments"):
+            val = data.get(key)
+            if isinstance(val, list) and val:
+                return True
+        return False
+
+    @staticmethod
     def answer_text(data: Dict) -> str:
         for key in ("textResponse", "response", "text", "message"):
             val = data.get(key)
