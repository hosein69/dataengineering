# Nobitex public market-data REST routes, tried left-to-right.
NOBITEX_API_BASES=https://api.nobitex.ir,https://api.nobitex.net

# Optional relay(s) that proxy Nobitex public REST unchanged.
# Example: https://your-iran-relay.example.com
NOBITEX_RELAY_BASES=

# Public WebSocket routes, tried left-to-right.
NOBITEX_WS_URLS=wss://wss.nobitex.ir/connection/websocket
NOBITEX_RELAY_WS_URLS=

NOBITEX_MARKETS=BTCIRT,ETHIRT,USDTIRT,ZECIRT
NOBITEX_HTTP_TIMEOUT_MS=10000
NOBITEX_WS_TIMEOUT_MS=20000
