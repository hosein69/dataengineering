+def commitment_equivalent_summary(df: pd.DataFrame) -> dict[str, object]:
+    """Aggregate source-backed commitment equivalents at REG grain.
+
+    ``FX_NTSW_BALANCE_EUR_EQ`` and ``FX_NTSW_BALANCE_RIAL_EQ`` are generated
+    only from same-REG/same-currency source evidence by the FX traceability
+    stage.  This helper deduplicates main-table fan-out and reports coverage so
+    a partial equivalent can never masquerade as a complete portfolio total.
+    """
+    result: dict[str, object] = {
+        "eur": None, "irr": None, "covered": 0, "total": 0,
+        "eur_covered": 0, "irr_covered": 0, "status": "UNAVAILABLE",
+    }
+    if df is None or df.empty:
+        return result
+    reg = _pick(df, _REGISTRATION_CANDIDATES)
+    if reg is None:
+        return result
+    cols = [reg]
+    for c in ("FX_NTSW_BALANCE_EUR_EQ", "FX_NTSW_BALANCE_RIAL_EQ", "FX_NTSW_EQ_STATUS"):
+        if c in df.columns:
+            cols.append(c)
+    if len(cols) == 1:
+        return result
+
+    z = df[cols].copy()
+    z["__reg"] = z[reg].astype(str).str.strip()
+    z = z[z["__reg"].ne("")]
+    if z.empty:
+        return result
+
+    # One FX-equivalent value per REG is expected. Conflicting fan-out values
+    # are excluded rather than arbitrarily selected.
+    rows = []
+    for key, g in z.groupby("__reg", sort=False):
+        row: dict[str, object] = {"reg": key}
+        conflict = False
+        for c in ("FX_NTSW_BALANCE_EUR_EQ", "FX_NTSW_BALANCE_RIAL_EQ"):
+            if c not in g.columns:
+                row[c] = None
+                continue
+            vals = pd.to_numeric(g[c], errors="coerce").dropna().unique().tolist()
+            if len(vals) > 1:
+                conflict = True
+                break
+            row[c] = float(vals[0]) if vals else None
+        if not conflict:
+            rows.append(row)
+    result["total"] = len(rows)
+    if not rows:
+        return result
+
+    eur_vals = [r["FX_NTSW_BALANCE_EUR_EQ"] for r in rows if r.get("FX_NTSW_BALANCE_EUR_EQ") is not None]
+    irr_vals = [r["FX_NTSW_BALANCE_RIAL_EQ"] for r in rows if r.get("FX_NTSW_BALANCE_RIAL_EQ") is not None]
+    result["eur_covered"] = len(eur_vals)
+    result["irr_covered"] = len(irr_vals)
+    result["covered"] = min(len(eur_vals), len(irr_vals))
+    result["eur"] = float(sum(eur_vals)) if eur_vals else None
+    result["irr"] = float(sum(irr_vals)) if irr_vals else None
+    if len(eur_vals) == len(rows) and len(irr_vals) == len(rows):
+        result["status"] = "COMPLETE"
+    elif eur_vals or irr_vals:
+        result["status"] = "PARTIAL"
+    return result
+
+
+def commitment_equivalent_display(df: pd.DataFrame) -> str:
+    """Human-readable EUR/IRR commitment equivalent with explicit coverage."""
+    s = commitment_equivalent_summary(df)
+    total = int(s["total"] or 0)
+    if not total:
+        return "معادل منبع‌محور در دسترس نیست"
+    parts: list[str] = []
+    if s["eur"] is not None:
+        parts.append(f"€ {float(s['eur']):,.2f} ({int(s['eur_covered'])}/{total} پرونده)")
+    if s["irr"] is not None:
+        parts.append(f"IRR {float(s['irr']):,.0f} ({int(s['irr_covered'])}/{total} پرونده)")
+    return " | ".join(parts) if parts else "معادل منبع‌محور در دسترس نیست"
