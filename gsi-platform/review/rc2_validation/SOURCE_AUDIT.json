      "pattern": "*BLs*Tracking*",
      "sheets": [
        "BLs Tracking"
      ],
      "join_on": "BL",
      "weight": 0.9,
      "required": false,
      "role": "ردیابی بارنامه‌ها (enrichment لجستیکی درجه‌دوم؛ سازنده جمعیت نیست)",
      "enabled": true
    },
    "moghavemat": {
      "folder": "${GS_COMBINE_OUT_DIR}",
      "pattern": "*Commercial Expert Data*",
      "sheets": [
        "Expert Data"
      ],
      "join_on": "ORDER",
      "frames": {
        "main": "ORDER",
        "inventory": "ORDER_MATERIAL"
      },
      "weight": 1.0,
      "required": false,
      "role": "مرجع درجه‌اول و سازنده جمعیت: چرخه خرید + موجودی کارشناسی نزد سازنده/درراه/گمرک",
      "enabled": true,
      "notes": "ستون Data type چند مقدار دارد (Pre Purchase Approval Data / Purchase Approval Data) پس فایل چندنوعی است. ستون BL No. حاوی شماره فنی/پروفرما است نه بارنامه و قرنطینه می‌شود. سه مقدار کمی «نزد سازنده / در راه / گمرک» منبع اصلی کارشناسی Supply Position هستند و در فریم inventory با دانه ORDER_MATERIAL ادغام می‌شوند؛ blank هرگز صفر فرض نمی‌شود.\n"
    },
    "sata": {
      "folder": "${BLS_TOTAL_DIR}",
      "pattern": "*SATA*",
      "sheets": [
        "Sata Tracking"
      ],
      "join_on": "BL",
      "weight": 0.9,
      "role": "پل بارنامه ↔ ثبت سفارش + کد رهگیری ساتا + اعتبارات (شاهد درجه‌دوم)",
      "enabled": true,
      "notes": "پل مستقیم و قوی BL ↔ ORDER ↔ REG است، اما تنها مسیر بیزینسی ثبت سفارش نیست. اتصال NTSW در DWH از هاب Import Licence و KEY_REG_FILE نیز برقرار می‌شود. SATA برای spine لجستیک شاهد مستقیم مهم است، نه منبع یگانه حقیقت.\n"
    },
    "clearance": {
      "folder": "${CLEARANCE_DIR}",
      "pattern": "*Clearance*",
      "sheets": [
        null
      ],
      "sheet_strategy": "all_data_sheets",
      "skip_sheets": [
        "Help",
        "Sheet2",
        "data",
        "Data",
        "راهنما"
      ],
      "join_on": "BL",
      "weight": 0.9,
      "multi_file": true,
      "dedupe_by": "CL_REF_DATE",
      "role": "ترخیص گمرکی — دریایی، هوایی، زمینی، چابهار",
      "enabled": true,
      "notes": "هر فایل شیت هم‌نام خودش را دارد (Sea/Air/Land/chabaharClearance) و تعداد ستون‌ها متفاوت است. «ترخیص کامل» و «ترخیص درصدی» علامت «*» هستند نه تاریخ؛ تاریخ واقعی در «تاریخ بارگیری» است.\n"
    },
    "cotage": {
      "folder": "${BLS_TOTAL_DIR}",
      "pattern": "*Cottage*",
      "sheets": [
        "Cottage Tracking"
      ],
      "join_on": "BL",
      "weight": 0.88,
      "role": "کوتاژ، ترخیص درصدی/کامل، مرز ورودی و گمرک مقصد",
      "enabled": true
    },
    "oracle": {
      "folder": "${BLS_TOTAL_DIR}",
      "pattern": "*Oracle*",
      "sheets": [
        null
      ],
      "join_on": "MATERIAL",
      "weight": 0.8,
      "role": "متریال، موجودی ایران‌خودرو و ساپکو، نیاز روزانه — مبنای مقاومت",
      "enabled": true,
      "notes": "ستون «قطعه بحراني» در فایل کاملاً خالی است، پس بحرانی بودن باید محاسبه شود. مقاومت = (موجودی ایران‌خودرو + ساپکو + در راه + در گمرک) ÷ نیاز روزانه قطعات.\n"
    },
    "ntsw": {
      "folder": "${FOREIGN_DIR}",
      "pattern": "*NTSW*",
      "sheets": [
        "Release Commitment",
        "Allocation",
        "Import License",
        "Import Licence"
      ],
      "join_on": "REG",
      "weight": 1.0,
      "required": false,
      "role": "مرجع درجه‌اول و سازنده جمعیت: مجوز واردات + تعهدات ارزی + تخصیص ارز",
      "enabled": true,
      "notes": "Import License/Import Licence محور اتصال شماره پرونده ثبت سفارش به NTSW است. Release Commitment و Allocation بر کد ثبت سفارش کار می‌کنند؛ اتصال آنها به سایر بیزینس از Import Licence → KEY_REG_FILE → IL Append و سپس کلیدهای معتبر IL انجام می‌شود. تعهدها چندردیفی و Allocation درخواست‌محور است.\n"
    },
    "fx_transaction": {
