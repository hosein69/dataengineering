+def relation_examples(df, sem, limit=12):
+    pairs=[("PR","PO"),("PR","ORDER"),("PR","MATERIAL"),("ORDER","REG"),("ORDER","BL"),("REG","REG_FILE"),("REG","COTTAGE"),("BL","COTTAGE")]
+    out=[]
+    for a,b in pairs:
