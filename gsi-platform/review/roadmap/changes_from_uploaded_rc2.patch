+def md_table(rows,cols):
+    if not rows: return "_None detected._"
+    esc=lambda x:str(x).replace("|","\\|").replace("\n"," ")
+    lines=["| "+" | ".join(cols)+" |","| "+" | ".join(["---"]*len(cols))+" |"]
