digraph G {
rankdir=RL; graph [bgcolor="#F6F8F9", pad="0.25", nodesep="0.45", ranksep="0.65"];
node [shape=box, style="rounded,filled", fontname="IRANSansWeb", fontsize=12, color="#0A7C86", fontcolor="#0B1F33", fillcolor="#FFFFFF", margin="0.16,0.10"];
edge [fontname="IRANSansWeb", fontsize=10, color="#667788", fontcolor="#0B1F33", arrowsize=0.75];
compound=true;
subgraph cluster_user { label="کاربر مجاز"; color="#D5DEE5"; style="rounded,dashed"; A [label="شروع", shape=oval]; B [label="انتخاب دامنه / اجرا"]; DL [label="دریافت بسته محلی"]; EP [label="پایان محلی", shape=oval]; }
subgraph cluster_core { label="هسته GSI"; color="#D5DEE5"; style="rounded,dashed"; V [label="اعتبارسنجی منبع"]; Q [label="Quality Gate عبور کرد؟", shape=diamond, fillcolor="#FFF6DF", color="#C79A4A"]; H [label="توقف Fail-closed", fillcolor="#F8EAEA", color="#8B2E2E"]; S [label="انتشار Snapshot", shape=cylinder, fillcolor="#EEF2F4", color="#0B1F33"]; }
subgraph cluster_pi { label="Process Intelligence"; color="#D5DEE5"; style="rounded,dashed"; EC [label="اعتبارسنجی Event Contract"]; PR [label="وضعیت / مسیر / Handoff"]; PC [label="Pattern config فعال؟", shape=diamond, fillcolor="#FFF6DF", color="#C79A4A"]; PV [label="اعتبارسنجی config"]; PG [label="config معتبر؟", shape=diamond, fillcolor="#FFF6DF", color="#C79A4A"]; PM [label="Match مشاهده‌ای + lineage"]; PB [label="HTML / Excel / EML / manifest"]; }
subgraph cluster_fs { label="فایل / Outlook"; color="#D5DEE5"; style="rounded,dashed"; PP [label="انتشار شبکه خواسته شده؟", shape=diamond, fillcolor="#FFF6DF", color="#C79A4A"]; PA [label="Automation / Share باز است؟", shape=diamond, fillcolor="#FFF6DF", color="#C79A4A"]; PH [label="توقف انتشار", fillcolor="#F8EAEA", color="#8B2E2E"]; PU [label="lock → staging → hash → rename"]; OD [label="Outlook draft بدون Send"]; ES [label="پایان منتشرشده", shape=oval]; }
A -> B -> V -> Q;
Q -> H [label="خیر"]; H -> EP;
Q -> S [label="بله"]; S -> EC -> PR -> PC;
PC -> PB [label="خیر"]; PC -> PV [label="بله"]; PV -> PG; PG -> H [label="خیر"]; PG -> PM [label="بله"]; PM -> PB;
PB -> DL -> PP; PP -> EP [label="خیر"]; PP -> PA [label="بله"]; PA -> PH [label="خیر"]; PH -> EP; PA -> PU [label="بله"]; PU -> OD -> ES;
}